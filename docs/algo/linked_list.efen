class LinkedList<T>
{
    struct node<T> {
        T data
        node next
    }

    var head: node?
    var last: node?

    constructor() {
    }

    fn append(dataConstructor: Constructor<T>) {
        let newNode = node<T>(next: null)

        if dataConstructor(node.data) == null {
            return
        }

        if self.head == null {
            self.head = newNode
            self.last = newNode
            return
        }

        self.last!.next = newNode
        self.last = newNode
    }

    fn prepend(dataConstructor: Constructor<T>) {
        let newNode = node<T>(next: null)

        if dataConstructor(node.data) == null {
            return
        }

        if self.head == null {
            self.last = newNode
        }

        self.head = newNode
    }

    fn traverse(handler: fn(T)) {
        var current = self.head

        while current != null {
            handler(current.data)
            current = current.next
        }
    }
}