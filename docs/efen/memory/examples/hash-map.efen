// Hash map with separate chaining.
//
// The example that exercises the whole model: a population with its own
// invariants, a container whose size is tied to another field, a derived index
// type that removes bounds checks, and cell walks for removal.
//
// No machine size is named anywhere. Whether `next` is stored as an eight-byte
// address, a four-byte index or a two-byte offset is the compiler's choice.
//
// Memory safety is mandatory. Structural invariants are optional proof goals.
// These sketches do not yet provide the pure Hashable contracts or helper
// contracts needed to verify all structural properties and exception paths.

layout HashMap<Key: Hashable, Value> {

    type Buckets: Size { value is 2^n }
    type Mask: Size { value is 2^n - 1 }

    set Entries: Entry {
        invariant reachable(e) {
            e in buckets[e.home].next*            // an entry hangs in its own bucket
        }
    }

    struct Entry {
        var key:   Key
        var hash:  UInt64 { hash == key.hash() }
        var value: Value
        var next:  own other Entries.pointer?

        // Derived, not stored: a wrong bucket number cannot be written, and a
        // new mask re-homes every entry at once.
        var home:  buckets.index { get { return bucketOf(hash) } }
    }

    var mask: Mask
    var buckets: [own Entries.pointer?] { .size == mask + 1 }

    constructor(capacity: Buckets = 1024) {
        mask = capacity - 1
        buckets = [own Entries.pointer?](size: capacity)
    }

    // The single derivation that carries the obligation. The conversion is where
    // the bound is established: `h & mask` is at most `mask` and the array holds
    // `mask + 1` cells, so a solver that reasons about bit vectors removes the
    // check. Until the predicate language admits `&`, the check stays.
    fn bucketOf(h: UInt64) -> buckets.index {
        return buckets.index(h & mask)
    }

    // The walk variable is a borrow with write rights over the block: it never
    // owns, so iterating a bucket cannot carry the chain out of the map.
    fn find(key: Key) -> Value? {
        let h = key.hash()

        for e in buckets[bucketOf(h)] along next {
            if e.hash == h && e.key == key {
                return e.value
            }
        }

        return null
    }

    fn insert(key: Key, value: Value) {
        let h = key.hash()
        let i = bucketOf(h)

        for e in buckets[i] along next {
            if e.hash == h && e.key == key {
                e.value = value            // replacing a value touches no invariant
                return
            }
        }

        var fresh = Entries.create(key: key, hash: h, value: value)
        fresh.next = take buckets[i]       // explicit transfer from the old root
        buckets[i] = take fresh            // explicit transfer of the new root

        if Entries.count > (mask + 1) * 3 / 4 {
            resize(capacity: (mask + 1) * 2)
        }
    }

    // Ordinary `cell.target` access borrows. `take` moves the block out of the
    // cell, and `Entries.take` moves it out of the population with its value.
    fn remove(key: Key) -> Value? {
        let h = key.hash()

        for cell in buckets[bucketOf(h)].slot along next {
            let e = cell.target

            if e.hash == h && e.key == key {
                var victim = cell.take()
                cell.target = take victim.next
                var removed = Entries.take(take victim)
                return take removed.value
            }
        }

        return null
    }

    // Only the links are rewritten: `home` follows the new mask on its own,
    // because it is derived rather than stored.
    fn resize(capacity: Buckets) {
        // Allocate before moving the old storage: allocation may fail.
        var replacement = [own Entries.pointer?](size: capacity)
        var old = take buckets

        mask = capacity - 1
        buckets = take replacement

        for cell in old.slots {
            while cell.target != null {
                var e = cell.take()
                cell.target = take e.next     // preserve the remaining old chain
                e.next = take buckets[e.home]
                buckets[e.home] = take e
            }
        }
    }
}

// Usage.

var index = HashMap<String, Int>(capacity: 1024)

index.insert("Ada", 1)
index.insert("Grace", 2)

echo index.find("Ada")        // 1
echo index.remove("Grace")    // 2
echo index.find("Grace")      // null
