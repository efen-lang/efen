// Doubly linked list.
//
// The back link is not written by hand: `inverse prev of next` declares it, so
// `x.next.prev == x` is maintained by the compiler and one assignment updates
// both directions. That is what makes `remove` short — and what makes it O(1),
// because the cell that owns a node is reachable from the node itself.

layout Deque<T> {

    set Nodes: Node {
        invariant reachable(n) {
            n in head.next*
        }
    }

    struct Node {
        var value: T
        var next:  own other Nodes.pointer?
    }

    inverse prev of next          // declares the field `prev`, kept in step with `next`

    var head: own Nodes.pointer?
    var tail: read Nodes.pointer? {
        (head == null) == (tail == null) && (tail == null || tail.next == null)
    }

    fn pushFront(value: T) {
        var node = Nodes.create(value: value, next: null)
        let wasEmpty = head == null            // comparison neither moves nor borrows

        node.next = take head                  // sets head.prev with it
        head = take node

        if wasEmpty {
            tail = head
        }
    }

    fn pushBack(value: T) {
        var node = Nodes.create(value: value, next: null)

        if tail == null {
            head = take node
            tail = head
        } else {
            tail.next = take node              // sets node.prev with it
            tail = tail.next
        }
    }

    // O(1): the owning cell of the node is either `head` or the `next` field of
    // its predecessor, and the predecessor is one load away.
    fn remove(node: read Nodes.pointer) -> T {
        let before = node.prev
        var cell = before == null ? head.slot : before.next.slot

        var victim = cell.take()               // acquire the owning reference
        cell.target = take victim.next         // prev of the new occupant follows

        if read cell.target == null {
            tail = before
        }

        var removed = Nodes.take(take victim)
        return take removed.value              // consume ownership and move the value
    }

    fn popBack() -> T? {
        if tail == null {
            return null
        }

        return remove(tail)
    }
}

// Usage.

var queue = Deque<Int>()

queue.pushBack(1)
queue.pushBack(2)
queue.pushFront(0)

for node in queue.head along next {
    echo node.value      // 0 1 2
}

// Backwards along the inverse field. Safety is checked independently;
// termination additionally requires a proven finite forward chain.
for node in queue.tail along prev {
    echo node.value      // 2 1 0
}
