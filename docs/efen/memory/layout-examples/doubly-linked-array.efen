private layout<T: Movable> {
    set Nodes: Node

    struct Node {
        var value: T
        var next: anchor Nodes.Item? = null
        var prev: Nodes.Item? = null

        invariants { next == null || next!.prev == self }
    }

    public struct DoublyList {
        private var head: anchor Nodes.Item? = null
        private var tail: Nodes.Item? = null
        public  var count: Int = 0 { value >= 0 }

        invariants {
            let nodes = Nodes.chain(from: head, by: Node.next, until: null)
            count == nodes.count
            head == null || head!.prev == null
            (head == null) == (tail == null)
            tail == null || tail!.next == null
        }
    }
}

private fn newNode<T>(value: own T) -> anchor Nodes<T>.Item {
    return mm.allocate(…) as Node<T>(value: take value)
}

private fn nodeAt<T>(list: edit DoublyList<T>, index: Int) -> edit Nodes<T>.Item
    requires index >= 0 && index < list.count
{
    if index <= list.count / 2 {
        var current = list.head!
        var position = 0
        while position < index {
            current = current.next!
            position += 1
        }
        return current
    }

    var current = list.tail!
    var position = list.count - 1
    while position > index {
        current = current.prev!
        position -= 1
    }
    return current
}

private fn nodeAtMut<T>(list: mut DoublyList<T>, index: Int) -> mut Nodes<T>.Item
    requires index >= 0 && index < list.count
{
    if index <= list.count / 2 {
        var current = list.head!
        var position = 0
        while position < index {
            current = current.next!
            position += 1
        }
        return current
    }

    var current = list.tail!
    var position = list.count - 1
    while position > index {
        current = current.prev!
        position -= 1
    }
    return current
}

private fn unlinkAt<T>(list: mut DoublyList<T>, index: Int) -> anchor Nodes<T>.Item? {
    if index == 0 {
        guard let first = tie list.head else { return null }
        list.head = tie first.next
        if let newHead = list.head {
            newHead.prev = null
        } else {
            list.tail = null
        }
        list.count -= 1
        return first
    }

    let before = nodeAtMut(list, index: index - 1)
    guard let victim = tie before.next else { return null }
    before.next = tie victim.next
    if let after = before.next {
        after.prev = before
    } else {
        list.tail = before
    }
    victim.prev = null
    list.count -= 1
    return victim
}

strategy<T> for DoublyList<T> {
    public edit fn pushFirst(value: own T) {
        let node = newNode(take value)
        if let first = head {
            first.prev = node
        }
        node.next = tie head
        head = tie node
        if tail == null {
            tail = head
        }
        count += 1
    }

    public edit fn append(value: own T) {
        let node = newNode(take value)
        if let last = tail {
            node.prev = last
            last.next = tie node
        } else {
            head = tie node
        }
        tail = node
        count += 1
    }

    public edit fn insert(index: Int, value: own T)
        requires index >= 0 && index <= count
    {
        if index == 0 {
            pushFirst(take value)
            return
        }
        if index == count {
            append(take value)
            return
        }

        let node = newNode(take value)
        let before = nodeAt(self, index: index - 1)
        node.prev = before
        node.next = tie before.next
        node.next!.prev = node
        before.next = tie node
        count += 1
    }

    public mut fn remove(index: Int) -> own T? {
        guard index >= 0 && index < count else { return null }
        guard let node = unlinkAt(self, index: index) else { return null }
        let value = take node.value
        mm.free(node as own Pointer)
        return value
    }

    public mut fn replace(index: Int, value: own T) -> own T
        requires index >= 0 && index < count
    {
        let node = nodeAtMut(self, index: index)
        return replace(node.value, take value)
    }

    public mut fn release
        requires T conforms ImplicitlyDestroyable
    {
        tail = null
        while let node = tie head {
            head = tie node.next
            if let newHead = head {
                newHead.prev = null
            }
            let dead = take node.value
            mm.free(node as own Pointer)
        }
        count = 0
    }
}

strategy<T: Copyable> for DoublyList<T> {
    public fn read(index: Int) -> T
        requires index >= 0 && index < count
    {
        var current = head!
        var position = 0
        while position < index {
            current = current.next!
            position += 1
        }
        return current.value
    }
}

var list = DoublyList<Int>()
defer list.release()
list.append(1)
list.pushFirst(0)
let second = list.read(1)
