contract IndexedSequence<Element> {
    var count: Int { get }
    fn read(index: Int) -> Element
        requires Element conforms Copyable
    mut fn replace(index: Int, value: own Element) -> own Element
        requires Element conforms Movable
}

contract ResizableSequence<Element> {
    mut fn append(value: own Element)
        requires Element conforms Movable
    mut fn insert(index: Int, value: own Element)
        requires Element conforms Movable
    mut fn remove(index: Int) -> own Element?
        requires Element conforms Movable
}
