const CHUNK_SIZE: Int = 256

private layout<T: Movable> {
    struct Chunk {
        var root: own Area<T>? = null { value == null || value.count == CHUNK_SIZE }
        var length: Int = 0 { value >= 0 && value <= CHUNK_SIZE }
        invariants { root == null || root!.initialized == length }
    }

    public struct ChunkedArray {
        var directory: own Area<Chunk>? = null {
            (value == null) == (directoryCapacity == 0) && (value == null || value.count == directoryCapacity)
        }
        var directoryCapacity: Int = 0 { value >= 0 }
        var directoryLength: Int = 0 { value >= 0 && value <= directoryCapacity }
        var count: Int = 0 { value >= 0 }

        invariants {
            directory == null || directory!.initialized == directoryLength
            count <= directoryLength * CHUNK_SIZE
            forall i in 0 ..< directoryLength:
                directory![i].root != null && directory![i].length == min(CHUNK_SIZE, max(0, count - i * CHUNK_SIZE))
        }
    }
}

private fn growDirectory<T: Movable>(a: edit ChunkedArray<T>, minimum: Int) {
    if minimum <= a.directoryCapacity {
        return
    }

    let next = max(minimum, max(4, a.directoryCapacity * 2))
    let fresh = Area<Chunk<T>>(count: next)

    if let old = take a.directory {
        var i = 0
        while i < a.directoryLength {
            fresh[i] = take old[i]
            i += 1
        }
    }                                           // old кончается: ни один слот не инициализирован, область возвращается

    a.directory = take fresh
    a.directoryCapacity = next
}

private fn ensureChunks<T: Movable>(a: edit ChunkedArray<T>, required: Int) {
    while a.directoryLength < required {
        growDirectory(a, minimum: a.directoryLength + 1)

        let block = Area<T>(count: CHUNK_SIZE)
        a.directory![a.directoryLength] = Chunk<T>(root: take block, length: 0)
        a.directoryLength += 1
    }
}

private fn movePosition<T: Movable>(a: mut ChunkedArray<T>, from: Int, to: Int) {
    a.directory![to / CHUNK_SIZE].root![to % CHUNK_SIZE] =
        take a.directory![from / CHUNK_SIZE].root![from % CHUNK_SIZE]
}

strategy<T> for ChunkedArray<T> {
    conforms Appendable<Item: T>

    public edit fn append(value: own T) nothrows {
        ensureChunks(self, required: 1 + count / CHUNK_SIZE)

        directory![count / CHUNK_SIZE].root![count % CHUNK_SIZE] = take value
        directory![count / CHUNK_SIZE].length += 1
        count += 1
    }

    public mut fn insert(index: Int, value: own T)
        requires index >= 0 && index <= count
    {
        ensureChunks(self, required: 1 + count / CHUNK_SIZE)

        let end = count / CHUNK_SIZE
        var i = count
        while i > index {
            movePosition(self, from: i - 1, to: i)
            i -= 1
        }

        directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE] = take value
        directory![end].length += 1
        count += 1
    }

    public mut fn remove(index: Int) -> own T? {
        guard index >= 0 && index < count else { return null }
        let removed = take directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE]
        var i = index
        while i + 1 < count {
            movePosition(self, from: i + 1, to: i)
            i += 1
        }

        directory![(count - 1) / CHUNK_SIZE].length -= 1
        count -= 1
        return removed
    }

    public mut fn replace(index: Int, value: own T) -> own T
        requires index >= 0 && index < count
    {
        let previous = take directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE]
        directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE] = take value
        return previous
    }

    public mut fn drain(each: (own T) -> Void nofail) {
        if let dir = take directory {
            var c = 0
            while c < directoryLength {
                let chunk = take dir[c]
                if let area = take chunk.root {
                    var j = 0
                    while j < chunk.length {
                        each(take area[j])
                        j += 1
                    }
                }                                  // area кончается: ни один слот не инициализирован
                c += 1
            }                                      // chunk кончается в конце шага: поле root равно null
        }                                          // dir кончается: ни один слот не инициализирован, область возвращается
        directoryLength = 0
        directoryCapacity = 0
        count = 0
    }
}

strategy<T> for ChunkedArray<T> {
    implements Disposable

    fn dispose {
        if let dir = take directory {
            var c = 0
            while c < directoryLength {
                let chunk = take dir[c]
                if let area = take chunk.root {
                    var j = 0
                    while j < chunk.length {
                        let dead = take area[j]         // значение T уничтожается в конце шага
                        j += 1
                    }
                }                                  // area кончается: ни один слот не инициализирован
                c += 1
            }                                      // chunk кончается в конце шага: поле root равно null
        }                                          // dir кончается: ни один слот не инициализирован, область возвращается
        directoryLength = 0
        directoryCapacity = 0
        count = 0
    }
}

strategy<T: Copyable> for ChunkedArray<T> {
    public fn read(index: Int) -> T
        requires index >= 0 && index < count
    {
        return copy directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE]
    }
}

strategy ChunkedAccess for ChunkedArray<T> {
    generic T: Movable
    generic Access: Access { value == read || value == edit }
    conforms Indexable<Item: Access T>

    Access fn at(index: Int) -> Access<self> T nothrows {
        guard index >= 0 && index < count else { throw BoundsError() }
        return &directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE]
    }
}

strategy ChunkedSwap for ChunkedArray<T> {
    generic T: Movable
    conforms Swappable

    edit fn swapAt(i: Int, j: Int) nothrows {
        guard i >= 0 && i < count && j >= 0 && j < count else { throw BoundsError() }
        if i != j {
            swap(directory![i / CHUNK_SIZE].root![i % CHUNK_SIZE], directory![j / CHUNK_SIZE].root![j % CHUNK_SIZE])
        }
    }
}

fn example {
    var a = ChunkedArray<Int>()
    a.append(1)
    a.append(2)
    let second = a.read(1)
}                                               // конец области: компилятор вызывает dispose

strategy<T> for Chunk<T> {
    implements Disposable

    fn dispose {
        if let area = take root {
            var j = 0
            while j < length {
                let dead = take area[j]         // значение T уничтожается в конце шага
                j += 1
            }
        }                                       // area кончается: ни один слот не инициализирован
        length = 0
    }
}

strategy<T> for ChunkedArray<T> {
    // переносит элементы source по порядку с начала и оставляет его пустым; если ensureChunks бросит, ничего не перенесено
    public mut fn append(moving source: mut ChunkedArray<T>) nothrows {
        ensureChunks(self, required: (count + source.count + CHUNK_SIZE - 1) / CHUNK_SIZE)
        var i = 0
        while i < source.count {
            let to = count + i
            directory![to / CHUNK_SIZE].root![to % CHUNK_SIZE] = take source.directory![i / CHUNK_SIZE].root![i % CHUNK_SIZE]
            directory![to / CHUNK_SIZE].length += 1
            i += 1
        }
        var c = 0
        while c < source.directoryLength {
            source.directory![c].length = 0       // блоки source остаются выделенными и пустыми
            c += 1
        }
        count += source.count
        source.count = 0
    }

    public mut fn append<I: ValueIterator<T>>(contentsOf source: mut I) nothrows {
        #if I conforms CountedIterator<T>
            ensureChunks(self, required: (count + source.remaining + CHUNK_SIZE - 1) / CHUNK_SIZE)   // блоки для всех значений сразу
        #endif
        while let value = source.next() {
            append(value: take value)
        }
    }
}

strategy<T: Copyable> for ChunkedArray<T> {
    // блоки для всех копий берутся сразу, затем копируется каждый элемент
    public mut fn append(contentsOf source: read Slice<T>) nothrows {
        ensureChunks(self, required: (count + source.count + CHUNK_SIZE - 1) / CHUNK_SIZE)
        var i = 0
        while i < source.count {
            append(value: copy source[i])
            i += 1
        }
    }
}
