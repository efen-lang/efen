const CHUNK_SIZE: Int = 256

private layout<T: Movable> {
    area Items: T
    area Chunks: Chunk

    struct Chunk {
        private var root: own Items.Area? = null { value == null || value.count == CHUNK_SIZE }
        private var length: Int = 0 { value >= 0 && value <= CHUNK_SIZE }
    }

    public struct ChunkedArray {
        private var directory: own Chunks.Area? = null { value == null || value.count == directoryCapacity }
        private var directoryCapacity: Int = 0 { value >= 0 }
        private var directoryLength: Int = 0 { value >= 0 && value <= directoryCapacity }
        public  var count: Int = 0 { value >= 0 }

        invariants {
            count <= directoryLength * CHUNK_SIZE
            forall i in 0 ..< directoryLength:
                directory![i].length == min(CHUNK_SIZE, max(0, count - i * CHUNK_SIZE))
        }
    }
}

private fn growDirectory<T: Movable>(a: mut ChunkedArray<T>, minimum: Int) {
    if minimum <= a.directoryCapacity {
        return
    }

    let next = max(minimum, max(4, a.directoryCapacity * 2))
    let fresh: Chunks<T>.Area = mm.allocate(…) as Chunks<T>.Area { value.count == next }

    if let old = take a.directory {
        var i = 0
        while i < a.directoryLength {
            fresh[i] = take old[i]
            i += 1
        }
        mm.free(old as Pointer)
    }

    a.directory = take fresh
    a.directoryCapacity = next
}

private fn ensureChunks<T: Movable>(a: mut ChunkedArray<T>, required: Int) {
    while a.directoryLength < required {
        growDirectory(a, minimum: a.directoryLength + 1)

        let block: Items<T>.Area = mm.allocate(…) as Items<T>.Area { value.count == CHUNK_SIZE }
        a.directory![a.directoryLength] = Chunk<T>(root: take block, length: 0)
        a.directoryLength += 1
    }
}

private fn movePosition<T: Movable>(a: mut ChunkedArray<T>, from: Int, to: Int) {
    a.directory![to / CHUNK_SIZE].root![to % CHUNK_SIZE] =
        take a.directory![from / CHUNK_SIZE].root![from % CHUNK_SIZE]
}

strategy<T> for ChunkedArray<T> {
    public mut fn append(value: own T) {
        ensureChunks(self, required: 1 + count / CHUNK_SIZE)

        directory![count / CHUNK_SIZE].root![count % CHUNK_SIZE] = take value
        directory![count / CHUNK_SIZE].length += 1
        count += 1
    }

    public mut fn insert(index: Int, value: own T)
        requires index >= 0 && index <= count
    {
        ensureChunks(self, required: 1 + count / CHUNK_SIZE)

        let end = count / CHUNK_SIZE
        var i = count
        while i > index {
            movePosition(self, from: i - 1, to: i)
            i -= 1
        }

        directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE] = take value
        directory![end].length += 1
        count += 1
    }

    public mut fn remove(index: Int) -> own T
        requires index >= 0 && index < count
    {
        let removed = take directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE]
        var i = index
        while i + 1 < count {
            movePosition(self, from: i + 1, to: i)
            i += 1
        }

        directory![(count - 1) / CHUNK_SIZE].length -= 1
        count -= 1
        return removed
    }

    public mut fn replace(index: Int, value: own T) -> own T
        requires index >= 0 && index < count
    {
        let previous = take directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE]
        directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE] = take value
        return previous
    }

    public mut fn release {
        if let dir = take directory {
            var c = 0
            while c < directoryLength {
                if let area = take dir[c].root {
                    var j = 0
                    while j < dir[c].length {
                        let dead = take area[j]
                        j += 1
                    }
                    mm.free(area as Pointer)
                }
                c += 1
            }
            mm.free(dir as Pointer)
        }
        directoryLength = 0
        directoryCapacity = 0
        count = 0
    }
}

strategy<T: Copyable> for ChunkedArray<T> {
    public fn read(index: Int) -> T
        requires index >= 0 && index < count
    {
        return directory![index / CHUNK_SIZE].root![index % CHUNK_SIZE]
    }
}

var a = ChunkedArray<Int>()
a.append(1)
a.append(2)
let second = a.read(1)
a.release()
