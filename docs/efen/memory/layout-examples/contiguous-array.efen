private layout<T> {
    area Items: T

    public struct FixedArray {
        private var items: own Items.Area? = null { value == null || value.count == count }
        public  var count: Int = 0 { value >= 0 }
    }
}

strategy<T: Movable> for FixedArray<T> {
    public mut fn fill(size: Int, make: (Int) -> own T)
        requires count == 0 && size >= 0
    {
        if size > 0 {
            let fresh: Items<T>.Area = mm.allocate(…) as Items<T>.Area { value.count == size }
            var i = 0
            while i < size {
                let value = make(i)
                fresh[i] = take value
                i += 1
            }
            items = take fresh
            count = size
        }
    }

    public mut fn replace(index: Int, value: own T) -> own T
        requires index >= 0 && index < count
    {
        let previous = take items![index]
        items![index] = take value
        return previous
    }

    public mut fn release {
        if let old = take items {
            var i = 0
            while i < count {
                let dead = take old[i]
                i += 1
            }
            mm.free(old as Pointer)
        }
        count = 0
    }
}

strategy<T: Copyable> for FixedArray<T> {
    public fn read(index: Int) -> T
        requires index >= 0 && index < count
    {
        return items![index]
    }
}

fn square(i: Int) -> own Int {
    return i * i
}

var a = FixedArray<Int>()
a.fill(size: 4, make: square)
let third = a.read(2)
a.release()
