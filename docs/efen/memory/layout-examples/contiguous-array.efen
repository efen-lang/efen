private layout<T: Movable, A: Allocator = mm> {
    public struct FixedArray {
        var items: own Area<T>? = null { (value == null) == (count == 0) && (value == null || value.count == count) }
        var count: Int = 0 { value >= 0 }
        invariants { items == null || items!.initialized == count }
        set Elements: items[_]
    }
}

strategy<T, A> for FixedArray<T, A> {
    public mut fn fill(size: Int, make: (Int) -> own T nofail)
        requires items == null && count == 0 && size >= 0
    {
        if size > 0 {
            let memory = A.allocate(size: size * sizeOf(T), aligned: alignOf(T))
            let fresh: Area<T> = memory as Area<T> { value.count == size }
            var i = 0
            while i < size {
                let value = make(i)
                fresh[i] = take value
                i += 1
            }
            items = take fresh
            count = size
        }
    }

    public mut fn replace(index: Int, value: own T) -> own T
        requires index >= 0 && index < count
    {
        let previous = take items![index]
        items![index] = take value
        return previous
    }

    public mut fn drain(each: (own T) -> Void nofail) {
        if let old = take items {
            var i = 0
            while i < count {
                each(take old[i])
                i += 1
            }
            A.deallocate(ptr: old as Pointer)   // ни один слот не инициализирован: память возвращается аллокатору
        }
        count = 0
    }
}

strategy<T, A> for FixedArray<T, A> {
    implements Disposable

    fn dispose {
        if let old = take items {
            var i = 0
            while i < count {
                let dead = take old[i]          // значение T уничтожается в конце шага
                i += 1
            }
            A.deallocate(ptr: old as Pointer)   // ни один слот не инициализирован: память возвращается аллокатору
        }
        count = 0
    }
}

strategy<T: Copyable, A> for FixedArray<T, A> {
    public fn read(index: Int) -> T
        requires index >= 0 && index < count
    {
        return copy items![index]
    }
}

strategy FixedArrayAccess for FixedArray<T, A> {
    generic T: Movable
    generic A: Allocator
    generic Access: Access { value == read || value == edit }
    conforms Sliceable<Item: Access T>

    Access fn at(index: Int) -> &Access<self.items![index]> T nothrows {
        guard index >= 0 && index < count else { throw BoundsError() }
        return &items![index]
    }

    Access fn slice(start: Int, end: Int) -> &Access<self.items![start ..< end]> Slice<T> nothrows {
        guard 0 <= start && start <= end && end <= count else { throw BoundsError() }
        return &items![start ..< end]
    }
}

strategy FixedArraySwap for FixedArray<T, A> {
    generic T: Movable
    generic A: Allocator
    conforms Swappable

    edit fn swapAt(i: Int, j: Int) nothrows {
        guard i >= 0 && i < count && j >= 0 && j < count else { throw BoundsError() }
        if i != j {
            swap(items![i], items![j])
        }
    }
}

fn number(i: Int) -> own Int nofail {
    return i
}

fn example {
    var a = FixedArray<Int>()
    a.fill(size: 4, make: number)
    let third = a.read(2)
}                                               // конец области: компилятор вызывает dispose
