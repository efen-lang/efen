aspect Contiguous<Target> conforms Representation<Target> {
    layout {
        set Items: Item {
            value in self.root[0..<self.length]
        }

        struct Item {
            Target
        }

        struct Self {
            var root: own Items.Area? = null

            var capacity: Size = 0 {
                (value == 0) == (self.root == null)
            }

            var length: Size = 0 {
                value == Items.count
                value == self.capacity
            }
        }
    }

    implementation {
        @constructor
        public fn init(
            count: Size,
            make: (Size) -> Target
        ) -> Self
            where Target: Movable
        {
            self.root = null
            self.capacity = count
            self.length = 0

            if count > 0 {
                self.root = Items.allocateArea(capacity: count)
            }

            for index in 0..<count {
                let value = make(index)
                Items.initialize(
                    root: self.root!,
                    index: index,
                    value: Item(take value)
                )
                self.length += 1
            }

            return self
        }

        public fn count -> Size {
            return self.length
        }

        fn itemAt(index: Size) -> Items.Item {
            if index >= self.length {
                throw BoundsError(index, self.length)
            }

            return Items.at(self.root!, index)
        }

        public fn read(index: Size) -> Target
            where Target: Copyable
        {
            return itemAt(index).Target
        }

        public fn replace(index: Size, value: own Target) -> Target
            where Target: Movable
        {
            let item = itemAt(index)
            let previous = replace(item.Target, value)

            return take previous
        }
    }
}
