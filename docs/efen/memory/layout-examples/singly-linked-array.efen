private layout<T: Movable> {
    set Nodes: Node

    struct Node {
        var value: T
        var next: anchor Nodes.Item? = null
    }

    public struct SinglyList {
        private var head: anchor Nodes.Item? = null
        private var tail: Nodes.Item? = null
        public  var count: Int = 0 { value >= 0 }

        invariants {
            let nodes = Nodes.chain(from: head, by: Node.next, until: null)
            count == nodes.count
            (head == null) == (tail == null)
            tail == nodes.last
        }
    }
}

private fn newNode<T>(value: own T) -> own Nodes<T>.Item {
    return Node<T>(value: take value)
}

private fn nodeAt<T>(list: edit SinglyList<T>, index: Int) -> edit Nodes<T>.Item
    requires index >= 0 && index < list.count
{
    var current = list.head!
    var position = 0
    while position < index {
        current = current.next!
        position += 1
    }
    return current
}

private fn nodeAtMut<T>(list: mut SinglyList<T>, index: Int) -> mut Nodes<T>.Item
    requires index >= 0 && index < list.count
{
    var current = list.head!
    var position = 0
    while position < index {
        current = current.next!
        position += 1
    }
    return current
}

private fn unlinkAt<T>(list: mut SinglyList<T>, index: Int) -> anchor Nodes<T>.Item? {
    if index == 0 {
        let first = tie list.head ?? return null
        list.head = tie first.next
        if list.head == null {
            list.tail = null
        }
        list.count -= 1
        return first
    }

    let before = nodeAtMut(list, index: index - 1)
    let victim = tie before.next ?? return null
    before.next = tie victim.next
    if before.next == null {
        list.tail = before
    }
    list.count -= 1
    return victim
}

strategy<T> for SinglyList<T> {
    public edit fn pushFirst(value: own T) {
        let node = newNode(take value)
        node.next = tie head
        head = tie node
        if tail == null {
            tail = head
        }
        count += 1
    }

    public edit fn append(value: own T) {
        let node = newNode(take value)
        if let last = tail {
            last.next = tie node
        } else {
            head = tie node
        }
        tail = node
        count += 1
    }

    public edit fn insert(index: Int, value: own T)
        requires index >= 0 && index <= count
    {
        if index == 0 {
            pushFirst(take value)
            return
        }
        if index == count {
            append(take value)
            return
        }

        let node = newNode(take value)
        let before = nodeAt(self, index: index - 1)
        node.next = tie before.next
        before.next = tie node
        count += 1
    }

    public mut fn remove(index: Int) -> own T? {
        guard index >= 0 && index < count else { return null }
        let node = unlinkAt(self, index: index) ?? return null
        let value = take node.value
        let dead = node as own Nodes<T>.Item
        return value
    }

    public mut fn replace(index: Int, value: own T) -> own T
        requires index >= 0 && index < count
    {
        let node = nodeAtMut(self, index: index)
        return replace(node.value, take value)
    }
}

strategy<T> for SinglyList<T> {
    implements Disposable

    fn dispose {
        tail = null
        while let node = tie head {
            head = tie node.next
            let dead = node as own Nodes<T>.Item     // указателей на узел нет; в конце шага value уничтожается, память возвращается
        }
        count = 0
    }
}

strategy<T: Copyable> for SinglyList<T> {
    public fn read(index: Int) -> T
        requires index >= 0 && index < count
    {
        var current = head!
        var position = 0
        while position < index {
            current = current.next!
            position += 1
        }
        return copy current.value
    }
}

fn example {
    var list = SinglyList<Int>()
    list.append(1)
    list.pushFirst(0)
    let second = list.read(1)
}                                               // конец области: компилятор вызывает dispose
