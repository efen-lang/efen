aspect List<Target> {
    conforms Representation<Target>
    layout {
        set Items: Item

        struct Item {
            Target
            var next: own other Items.Item? = null
        }

        struct Self {
            var head: own Items.Item? = null
            var tail: read Items.Item? = null
            var length: Size = 0
            ghost var nodes: Sequence<Items.Item> = Sequence()

            invariants {
                head == nodes.first
                forall i in 0 ..< nodes.count - 1: nodes[i].next == nodes[i + 1]
                nodes.count == 0 || nodes.last!.next == null
                nodes.count == Items.count
                tail == nodes.last
                length == nodes.count
            }
        }
    }

    implementation {
        @constructor
        public fn init -> Self {
            self.head = null
            self.tail = null
            self.length = 0
            return self
        }

        fn itemAt(index: Size) -> Items.Item {
            if index >= self.length {
                throw BoundsError(index, self.length)
            }

            var current = self.head!
            var position: Size = 0

            while position < index {
                current = current.next!
                position += 1
            }

            return current
        }

        public fn count -> Size {
            return self.length
        }

        public fn read(index: Size) -> Target
            requires Target conforms Copyable
        {
            return itemAt(index).Target
        }

        public fn replace(index: Size, value: own Target) -> Target
            requires Target conforms Movable
        {
            let item = itemAt(index)
            let previous = replace(item.Target, value)

            return take previous
        }

        public fn append(value: own Target)
            requires Target conforms Movable
        {
            let nextLength = self.length + 1
            let item = Items.allocate(
                Item(take value, next: null)
            )
            ghost nodes = nodes + Sequence(item)

            if self.tail == null {
                self.head = take item
                self.tail = self.head
            } else {
                self.tail!.next = take item
                self.tail = self.tail!.next
            }

            self.length = nextLength
        }

        public fn insert(index: Size, value: own Target)
            requires Target conforms Movable
        {
            if index > self.length {
                throw BoundsError(index, self.length)
            }

            if index == self.length {
                append(take value)
                return
            }

            let nextLength = self.length + 1
            let item = Items.allocate(
                Item(take value, next: null)
            )
            ghost nodes = nodes[0 ..< index] + Sequence(item) + nodes[index ..< nodes.count]

            if index == 0 {
                item.next = take self.head
                self.head = take item
            } else {
                let before = itemAt(index - 1)
                item.next = take before.next
                before.next = take item
            }

            self.length = nextLength
        }

        public fn remove(index: Size) -> Target
            requires Target conforms Movable
        {
            if index >= self.length {
                throw BoundsError(index, self.length)
            }

            var victim: own Items.Item
            ghost nodes = nodes[0 ..< index] + nodes[index + 1 ..< nodes.count]

            if index == 0 {
                victim = take self.head!
                self.head = take victim.next

                if self.head == null {
                    self.tail = null
                }
            } else {
                let before = itemAt(index - 1)
                victim = take before.next!
                before.next = take victim.next

                if before.next == null {
                    self.tail = before
                }
            }

            self.length -= 1
            let result = take victim.Target
            Items.free(take victim)
            return take result
        }
    }
}
