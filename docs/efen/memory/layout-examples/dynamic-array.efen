private layout<T: Movable> {
    area Items: T

    public struct Vector {
        private var items: own Items.Area? = null { value == null || value.count == capacity }
        public  var capacity: Int = 0 { value >= 0 }
        public  var count: Int = 0 { value >= 0 && value <= capacity }
    }
}

private fn grow<T: Movable>(v: mut Vector<T>, minimum: Int) {
    let next = max(minimum, max(8, v.capacity * 2))
    let fresh: Items<T>.Area = mm.allocate(bytes: next * sizeOf(T)) as Items<T>.Area { value.count == next }

    if let old = take v.items {
        var i = 0
        while i < v.count {
            fresh[i] = take old[i]
            i += 1
        }
        mm.free(old as Pointer)
    }

    v.items = take fresh
    v.capacity = next
}

strategy<T> for Vector<T> {
    public mut fn reserve(minimum: Int) {
        if minimum > capacity {
            grow(self, minimum: minimum)
        }
    }

    public mut fn append(value: own T) {
        reserve(count + 1)
        items![count] = take value
        count += 1
    }

    public mut fn insert(index: Int, value: own T)
        requires index >= 0 && index <= count
    {
        reserve(count + 1)
        var i = count
        while i > index {
            items![i] = take items![i - 1]
            i -= 1
        }
        items![index] = take value
        count += 1
    }

    public mut fn remove(index: Int) -> own T? {
        guard index >= 0 && index < count else { return null }
        let removed = take items![index]
        var i = index
        while i + 1 < count {
            items![i] = take items![i + 1]
            i += 1
        }
        count -= 1
        return removed
    }

    public mut fn replace(index: Int, value: own T) -> own T
        requires index >= 0 && index < count
    {
        let previous = take items![index]
        items![index] = take value
        return previous
    }

    public mut fn drain(each: (own T) -> Void) {
        if let old = take items {
            var i = 0
            while i < count {
                each(take old[i])
                i += 1
            }
            mm.free(old as Pointer)
        }
        count = 0
        capacity = 0
    }
}

strategy<T> for Vector<T> {
    implements Disposable

    fn dispose {
        if let old = take items {
            var i = 0
            while i < count {
                let dead = take old[i]          // значение T уничтожается в конце шага
                i += 1
            }
            mm.free(old as Pointer)
        }
        count = 0
        capacity = 0
    }
}

strategy<T: Copyable> for Vector<T> {
    public fn read(index: Int) -> T
        requires index >= 0 && index < count
    {
        return copy items![index]
    }
}

fn example {
    var v = Vector<Int>()
    v.append(1)
    v.append(2)
    let first = v.read(0)
}                                               // конец области: компилятор вызывает dispose
