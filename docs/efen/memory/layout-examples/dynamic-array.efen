private layout<T: Movable> {
    public struct Vector {
        var items: own Area<T>? = null { (value == null) == (capacity == 0) && (value == null || value.count == capacity) }
        var capacity: Int = 0 { value >= 0 }
        var count: Int = 0 { value >= 0 && value <= capacity }
        invariants { items == null || items!.initialized == count }
    }
}

private fn grow<T: Movable>(v: mut Vector<T>, to: Int) {
    let fresh = Area<T>(count: to)

    if let old = take v.items {
        var i = 0
        while i < v.count {
            fresh[i] = take old[i]
            i += 1
        }
    }                                           // old кончается: ни один слот не инициализирован, область возвращается

    v.items = take fresh
    v.capacity = to
}

strategy<T> for Vector<T> {
    conforms RoomAppendable<Item: T>

    // доводит ёмкость до той, которой достигло бы добавление по одному: те же шаги, одно выделение
    public mut fn reserve(room: Int) nothrows
        requires room >= 0
    {
        var next = capacity
        while next - count < room {
            next = max(8, next * 2)
        }
        if next != capacity {
            grow(self, to: next)
        }
    }

    public mut fn append(value: own T) nothrows {
        if count == capacity {
            grow(self, to: max(8, capacity * 2))
        }
        items![count] = take value
        count += 1
    }

    public edit fn append(value: own T) nofail   // запас взят заранее: ни один слот не двигается
        requires count < capacity
    {
        items![count] = take value
        count += 1
    }

    // переносит элементы source по порядку с начала и оставляет его пустым; если reserve бросит, ничего не перенесено
    public mut fn append(moving source: mut Vector<T>) nothrows {
        reserve(room: source.count)
        if let old = take source.items {
            var i = 0
            while i < source.count {
                items![count + i] = take old[i]
                i += 1
            }
        }                                       // old кончается: ни один слот не инициализирован, область возвращается
        count += source.count
        source.count = 0
        source.capacity = 0
    }

    public mut fn append<I: ValueIterator<T>>(contentsOf source: mut I) nothrows {
        #if I conforms CountedIterator<T>
            reserve(room: source.remaining)     // число значений известно заранее: один рост
        #endif
        while let value = source.next() {
            append(value: take value)
        }
    }

    public mut fn insert(index: Int, value: own T)
        requires index >= 0 && index <= count
    {
        reserve(room: 1)
        var i = count
        while i > index {
            items![i] = take items![i - 1]
            i -= 1
        }
        items![index] = take value
        count += 1
    }

    public mut fn remove(index: Int) -> own T? {
        guard index >= 0 && index < count else { return null }
        let removed = take items![index]
        var i = index
        while i + 1 < count {
            items![i] = take items![i + 1]
            i += 1
        }
        count -= 1
        return removed
    }

    public mut fn replace(index: Int, value: own T) -> own T
        requires index >= 0 && index < count
    {
        let previous = take items![index]
        items![index] = take value
        return previous
    }

    public mut fn drain(each: (own T) -> Void nofail) {
        if let old = take items {
            var i = 0
            while i < count {
                each(take old[i])
                i += 1
            }
        }                                       // old кончается: ни один слот не инициализирован, область возвращается
        count = 0
        capacity = 0
    }
}

strategy<T> for Vector<T> {
    implements Disposable

    fn dispose {
        if let old = take items {
            var i = 0
            while i < count {
                let dead = take old[i]          // значение T уничтожается в конце шага
                i += 1
            }
        }                                       // old кончается: ни один слот не инициализирован, область возвращается
        count = 0
        capacity = 0
    }
}

strategy<T: Copyable> for Vector<T> {
    public fn read(index: Int) -> T
        requires index >= 0 && index < count
    {
        return copy items![index]
    }

    // один reserve, затем копия каждого элемента; для ImplicitlyCopyable генератор кода пишет одно блочное копирование
    public mut fn append(contentsOf source: read Slice<T>) nothrows {
        reserve(room: source.count)
        var i = 0
        while i < source.count {
            items![count] = copy source[i]
            count += 1
            i += 1
        }
    }
}

fn example {
    var v = Vector<Int>()
    v.append(1)
    v.append(2)
    let first = v.read(0)
}                                               // конец области: компилятор вызывает dispose

strategy VectorAccess for Vector<T> {
    generic T: Movable
    generic Access: Access { value == read || value == edit }
    conforms Sliceable<Item: Access T>

    Access fn at(index: Int) -> Access<&self.items![index]> T nothrows {
        guard index >= 0 && index < count else { throw BoundsError() }
        return &items![index]
    }

    Access fn slice(start: Int, end: Int) -> Access<&self.items![start ..< end]> Slice<T> nothrows {
        guard 0 <= start && start <= end && end <= count else { throw BoundsError() }
        return &items![start ..< end]
    }
}

strategy VectorSwap for Vector<T> {
    generic T: Movable
    conforms Swappable

    edit fn swapAt(i: Int, j: Int) nothrows {
        guard i >= 0 && i < count && j >= 0 && j < count else { throw BoundsError() }
        if i != j {
            swap(items![i], items![j])
        }
    }
}
